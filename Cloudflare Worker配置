export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const targetHost = "xxx.com";  // 只需修改xxx.com为自己域名。
    const hostname = url.hostname;
    const sub = hostname.replace(`.${targetHost}`, ""); 
    const ipLikePattern = /^\d{1,3}(-\d{1,3}){3}$/;  // 仅接受子域为IP格式的域名转发

    let isValid = false;

    if (ipLikePattern.test(sub)) {
      const parts = sub.split("-").map(Number);
      isValid = parts.every(n => n >= 0 && n <= 255);
    }

    if (!isValid) {
      return fetch(request);
    }

    url.host = targetHost;

    const newHeaders = new Headers(request.headers);

    newHeaders.set("Host", targetHost);
    newHeaders.set("X-Forwarded-Host", request.headers.get("host"));

    const modifiedRequest = new Request(url.toString(), {
      method: request.method,
      headers: newHeaders,
      body: request.body,
      redirect: "follow"
    });

    return fetch(modifiedRequest);
  },
};
